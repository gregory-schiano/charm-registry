CHARM_REGISTRY_LISTEN=:8080
CHARM_REGISTRY_PUBLIC_API_URL=http://localhost:8080
CHARM_REGISTRY_PUBLIC_STORAGE_URL=http://localhost:8080
# For Juju, snap, or any external client running outside this host, set these
# to a reachable host/IP instead of localhost, for example:
# CHARM_REGISTRY_PUBLIC_API_URL=http://192.0.2.10:8080
# CHARM_REGISTRY_PUBLIC_STORAGE_URL=http://192.0.2.10:8080
# The embedded OCI registry listens separately from the Charmhub-compatible API.
# If Juju/containerd runs outside this host, set this to a reachable host/IP.
# Generate a local TLS certificate for this hostname and install it on clients
# that need to trust the embedded OCI registry.
CHARM_REGISTRY_PUBLIC_REGISTRY_URL=https://localhost:5000

# API TLS (optional: set both to enable direct TLS termination on the API server)
# CHARM_REGISTRY_API_TLS_CERT_FILE=
# CHARM_REGISTRY_API_TLS_KEY_FILE=

CHARM_REGISTRY_DATABASE_BACKEND=auto
CHARM_REGISTRY_DATABASE_URL=postgres://postgres:postgres@localhost:5432/charm_registry?sslmode=disable
CHARM_REGISTRY_DATA_DIR=data
CHARM_REGISTRY_SQLITE_PATH=data/registry.sqlite

CHARM_REGISTRY_STORAGE_BACKEND=auto
CHARM_REGISTRY_BLOB_DIR=data/blobs
CHARM_REGISTRY_S3_BUCKET=charm-registry-blobs
CHARM_REGISTRY_S3_REGION=us-east-1
CHARM_REGISTRY_S3_ENDPOINT=http://localhost:9000
CHARM_REGISTRY_S3_ACCESS_KEY_ID=registry-app
CHARM_REGISTRY_S3_SECRET_ACCESS_KEY=registry-app-secret
CHARM_REGISTRY_S3_USE_PATH_STYLE=true
CHARM_REGISTRY_S3_DISABLE_TLS=false

CHARM_REGISTRY_OCI_LISTEN=:5000
# Host port used by the embedded OCI listener. If CHARM_REGISTRY_PUBLIC_REGISTRY_URL
# uses a non-5000 port, set this to match.
CHARM_REGISTRY_OCI_INTERNAL_URL=https://127.0.0.1:5000
CHARM_REGISTRY_OCI_STORAGE_BACKEND=auto
CHARM_REGISTRY_OCI_STORAGE_DIR=data/oci-registry
CHARM_REGISTRY_OCI_S3_BUCKET=charm-registry-oci
CHARM_REGISTRY_OCI_S3_PREFIX=oci
# OCI S3 storage falls back to the main S3 variables when these are not set.
# CHARM_REGISTRY_OCI_S3_REGION=
# CHARM_REGISTRY_OCI_S3_ENDPOINT=
# CHARM_REGISTRY_OCI_S3_ACCESS_KEY=
# CHARM_REGISTRY_OCI_S3_SECRET_KEY=
# CHARM_REGISTRY_OCI_S3_USE_PATH_STYLE=
CHARM_REGISTRY_OCI_SECRET_KEY=replace-this-oci-secret
CHARM_REGISTRY_OCI_PROJECT_PREFIX=charm
CHARM_REGISTRY_OCI_PULL_ROBOT_PREFIX=pull
CHARM_REGISTRY_OCI_PUSH_ROBOT_PREFIX=push
CHARM_REGISTRY_OCI_TLS_CERT_FILE=/certs/oci.crt
CHARM_REGISTRY_OCI_TLS_KEY_FILE=/certs/oci.key
CHARM_REGISTRY_OCI_MAX_MANIFEST_BYTES=16MB

CHARM_REGISTRY_OIDC_ISSUER_URL=
CHARM_REGISTRY_OIDC_CLIENT_ID=
CHARM_REGISTRY_OIDC_USERNAME_CLAIM=preferred_username
CHARM_REGISTRY_OIDC_DISPLAY_NAME_CLAIM=name
CHARM_REGISTRY_OIDC_EMAIL_CLAIM=email
CHARM_REGISTRY_ADMIN_SUBJECTS=
CHARM_REGISTRY_ADMIN_EMAILS=
CHARM_REGISTRY_ADMIN_USERNAMES=

# Comma-separated IPs/CIDRs of trusted reverse proxies. Only requests arriving
# from these peers have their X-Forwarded-For / X-Real-IP / True-Client-IP
# headers honoured for the client IP used in per-IP rate limiting and logging.
# Leave empty to trust no proxy (use the transport peer address). Set this to
# your ingress/proxy range when the registry runs behind one, otherwise all
# traffic shares one rate-limit bucket.
CHARM_REGISTRY_TRUSTED_PROXIES=

CHARM_REGISTRY_ENABLE_INSECURE_DEV_AUTH=true

CHARM_REGISTRY_CHARMHUB_URL=https://api.charmhub.io
CHARM_REGISTRY_CHARMHUB_SYNC_INTERVAL=15m
CHARM_REGISTRY_CHARMHUB_MAX_RESPONSE_BYTES=4MB
CHARM_REGISTRY_CHARMHUB_MAX_ARTIFACT_BYTES=64MB

# Optional convenience vars for the admin CLI:
# CHARM_REGISTRY_URL=http://localhost:8080
# CHARM_REGISTRY_TOKEN=dev:admin:admin

CHARM_REGISTRY_SERVER_READ_HEADER_TIMEOUT=10s
CHARM_REGISTRY_SERVER_READ_TIMEOUT=30s
CHARM_REGISTRY_SERVER_WRITE_TIMEOUT=30s
CHARM_REGISTRY_SERVER_IDLE_TIMEOUT=2m
CHARM_REGISTRY_SERVER_SHUTDOWN_TIMEOUT=30s
# OCI server timeouts — defaults disable read/write limits for large blob transfers.
# Set to a positive duration only if you need to cap slow clients.
# CHARM_REGISTRY_OCI_SERVER_READ_HEADER_TIMEOUT=10s
# CHARM_REGISTRY_OCI_SERVER_READ_TIMEOUT=0
# CHARM_REGISTRY_OCI_SERVER_WRITE_TIMEOUT=0
# CHARM_REGISTRY_OCI_SERVER_IDLE_TIMEOUT=5m
CHARM_REGISTRY_SERVER_MAX_HEADER_BYTES=1MB
CHARM_REGISTRY_MAX_JSON_BODY_BYTES=1MB
CHARM_REGISTRY_MAX_ARCHIVE_FILE_BYTES=10MB
CHARM_REGISTRY_MAX_UPLOAD_BYTES=64MB
